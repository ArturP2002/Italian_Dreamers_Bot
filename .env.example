# Telegram
BOT_TOKEN=0000000000:REPLACE_ME
ADMIN_TELEGRAM_IDS=123456789
CHANNEL_ID=-1001234567890
WEBAPP_URL=https://your-tunnel.example.com
CORS_ORIGINS=http://localhost:5173,https://your-tunnel.example.com

# Database
DATABASE_URL=postgresql+asyncpg://dreamers:dreamers@localhost:5432/dreamers

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_TIMEZONE=Europe/Moscow
ALLOW_DEV_AUTH=true

# Frontend local (web/.env) — optional
# VITE_API_BASE_URL=
# VITE_DEV_TELEGRAM_ID=123456789

# Optional — translation (OpenAI gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Prices (Stars) — placeholders from ТЗ, recalculate before launch
PRICE_MESSAGE_CREDIT_STARS=258
PRICE_MESSAGE_PACK_9_STARS=1920
MESSAGE_PACK_SIZE=9
PRICE_PROFILE_PUBLISH_STARS=3000
PRICE_AD_SLOT_STARS=9000

# Rate limits
RATE_CONTACT_PER_HOUR=5
RATE_CONTACT_PER_DAY=15
RATE_MAX_PENDING_OUTGOING=3
RATE_SOFT_BAN_HOURS=12
