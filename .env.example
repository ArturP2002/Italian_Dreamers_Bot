# Telegram
BOT_TOKEN=0000000000:REPLACE_ME
ADMIN_TELEGRAM_IDS=123456789
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/italiandreamers
WEBAPP_URL=https://your-tunnel.example.com
CORS_ORIGINS=http://localhost:5173,https://your-tunnel.example.com

# Database
DATABASE_URL=postgresql+asyncpg://dreamers:dreamers@localhost:5432/dreamers

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_TIMEZONE=Europe/Rome
ALLOW_DEV_AUTH=true

# Frontend local (web/.env) — optional
# VITE_API_BASE_URL=
# VITE_DEV_TELEGRAM_ID=123456789

# Optional — translation (OpenAI gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Prices (Stars)
